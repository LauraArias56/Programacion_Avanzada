# Copia este archivo a .env y ajusta los valores antes de usar Docker Compose.
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

POSTGRES_USER=vguser
POSTGRES_PASSWORD=vgpass
POSTGRES_DB=video_games
POSTGRES_PORT=5432

API_PORT=8000
VISION_PORT=8100
WEBAPP_PORT=5000

# La app usa estos valores dentro de Docker Compose; en local apunta a la API real.
# API_BASE_URL=http://api:8000
# VISION_API_BASE_URL=http://vision:8100
# DATABASE_URL=postgresql+psycopg://vguser:vgpass@postgres:5432/video_games

LOG_LEVEL=INFO
LOG_DIR=logs
SESSION_COOKIE_SECURE=0
RATELIMIT_ENABLED=1

# URLs cuando ejecutas Flask fuera de Docker.
# API_BASE_URL=http://127.0.0.1:8000
# VISION_API_BASE_URL=http://127.0.0.1:8100

VISION_API_TIMEOUT=20
VISION_API_RETRIES=2
VISION_MODEL_INFO_TTL=300
VISION_MAX_UPLOAD_MB=8

# Copia de seguridad diaria de PostgreSQL (servicio `backup` en Compose).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=7
